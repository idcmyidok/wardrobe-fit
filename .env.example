# 키 이름만 적는다. 실제 값은 .env.local(로컬) 또는 Vercel 환경 변수에 넣는다.
# 현재 단계(project-init)에서는 아래 값을 사용하지 않는다.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (3단계 Authentication부터 사용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 클라이언트 코드에서 절대 참조하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# AI 구매 판단기 (10단계부터 사용, 서버 전용)
ANTHROPIC_API_KEY=
