# 키 이름만 적는다. 실제 값은 .env.local(로컬) 또는 Vercel 환경 변수에 넣는다.
# Supabase 두 값이 비어 있으면 인증 없이 예시 데이터로만 둘러보는 미리보기 모드가 된다.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API). anon 대신 publishable key를 쓰면 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY에 넣어도 된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 클라이언트 코드에서 절대 참조하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# AI 구매 판단기 (10단계, 서버 전용). 둘 다 비워 두면 AI 없이 치수 비교 규칙 요약만 쓴다(비용 0).
# 1순위 GEMINI_API_KEY(Google AI Studio 무료 등급): 무료 등급은 입력을 학습에 쓸 수 있어 실측·계산값만 보낸다(후기·옷 이름 제외).
# 2순위 ANTHROPIC_API_KEY(Claude Haiku 4.5, 유료): 후기 원문까지 보내 근거 인용을 만든다.
# 한도 초과·오류면 자동으로 규칙 요약. 사용자당 하루 10회(FIT_AI_DAILY_LIMIT), 같은 입력은 7일 캐시.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# FIT_AI_DAILY_LIMIT=10
# FIT_AI_ENABLED=0   # 키가 있어도 AI를 끈다

# 신체치수 암호화 키(서버 전용, 1.2.6). base64로 적은 32바이트. 잃어버리면 저장된 내 치수를 되살릴 수 없다.
# 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BODY_ENCRYPTION_KEY=
