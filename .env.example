# 키 이름만 적는다. 실제 값은 .env.local(로컬) 또는 Vercel 환경 변수에 넣는다.
# Supabase 두 값이 비어 있으면 인증 없이 예시 데이터로만 둘러보는 미리보기 모드가 된다.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API). anon 대신 publishable key를 쓰면 NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY에 넣어도 된다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 클라이언트 코드에서 절대 참조하지 않는다.
SUPABASE_SERVICE_ROLE_KEY=

# AI 구매 판단기 (10단계부터 사용, 서버 전용)
ANTHROPIC_API_KEY=
